#!/bin/sh
#
# Rusty Backup pre-commit hook (managed via cargo-husky `user-hooks`).
# Edit THIS file, not .git/hooks/pre-commit — cargo-husky regenerates the
# installed copy from here on the next `cargo build` / `cargo test`.
#
# Runs the general Rust cleanup tasks before each commit:
#   1. cargo fmt      — auto-format and re-stage (always; cheap)
#   2. cargo clippy   — type-check + lint the whole workspace, warnings denied
#   3. gen-cli-docs   — regenerate + re-stage the CLI docs when src/cli changed
#
# Steps 2-3 only run when the commit touches Rust sources or Cargo manifests,
# so docs-only commits stay fast; step 3 further narrows to `src/cli/` changes.
# Any failure aborts the commit.
#
# There is deliberately no separate `cargo check` pass: clippy is `cargo check`
# plus lints, so a type error fails here exactly the same way, and the check
# pass was a second full walk of a ~400k-line crate on every commit. That walk
# is memory-heavy enough to matter on 16 GB machines — see
# docs/build-memory-crashes.md before adding anything heavier to this hook.

set -e

# --- 1. Format and re-stage ------------------------------------------------
echo "pre-commit: cargo fmt --all"
cargo fmt --all
git add -u

# --- Skip heavy checks for non-Rust commits --------------------------------
# Look at what's actually staged (after the fmt re-stage above).
staged_rust=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '\.rs$|(^|/)Cargo\.(toml|lock)$' || true)

if [ -z "$staged_rust" ]; then
  echo "pre-commit: no Rust/Cargo changes staged; skipping clippy"
  exit 0
fi

# --- 2. Type-check + lint (warnings denied) --------------------------------
echo "pre-commit: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

# --- 2b. Lint the regression harness ----------------------------------------
# regression-tests/runner is its OWN crate, not a member of the root
# workspace, so step 2 never sees it. It accumulated ten warnings that way
# before anyone noticed. Only runs when the commit touches it, so the usual
# engine commit pays nothing.
staged_regress=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^regression-tests/runner/' || true)

if [ -n "$staged_regress" ]; then
  echo "pre-commit: regression-tests/runner changed — clippy there too"
  cargo clippy --manifest-path regression-tests/runner/Cargo.toml \
    --all-targets -- -D warnings
fi

# --- 3. Regenerate CLI docs when the grammar may have changed ---------------
# The reference (docs/cli-reference.md) and HTML bundle (docs/cli-html-help/)
# are generated from the clap definitions under src/cli/. Regenerate and
# re-stage them so they can never drift from the code in the same commit.
staged_cli=$(git diff --cached --name-only --diff-filter=ACMR \
  | grep -E '^src/cli/|^example/generate_cli_' || true)

if [ -n "$staged_cli" ]; then
  echo "pre-commit: src/cli changed — regenerating CLI docs"
  # Pure-Rust, cross-platform generator (prunes stale pages, writes both the
  # Markdown reference and the HTML bundle). See example/generate_cli_docs.rs.
  cargo run --quiet --example generate_cli_docs
  # -A so pruned pages (renamed/removed subcommands) are staged as deletions.
  git add -A docs/cli-reference.md docs/cli-html-help
fi

echo "pre-commit: all checks passed"
