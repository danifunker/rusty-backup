# The mrustc the Mac OS X PowerPC build uses: the fork, one exact commit.
# scripts/build-ppc.sh refuses to build from any other (MRUSTC_UNPINNED=1 to experiment), and
# `scripts/build-ppc.sh mrustc-sync` checks this commit out. To move the pin, push the new
# commit to the fork first, then change MRUSTC_COMMIT here in the same change that needs it.
MRUSTC_REPO=https://github.com/danifunker/mrustc.git
MRUSTC_BRANCH=ppc-build-2026-09
MRUSTC_COMMIT=52d41fe9c0a298d921676f8d7960ed9706d38aa2
